rules_version = '2';

// Circlo Firestore Rules — Increment 1 (accounts + circles).
// Default deny. Any path not matched below is inaccessible.
// Scope notes (see docs/review-findings.md):
//  - Join codes are validated here; there is no trusted server, so codes are long (10 chars, ~49 bits)
//    and never listable. Approval, ownership transfer and circle deletion use rule-checked client batches;
//    regression tests exist in firebase/tests/rules.test.mjs but must run in the Emulator before release.
//  - Minimum age is 13 (open question Q2b); keep in sync with app/lib/core/validators.dart.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function circlePath(cid) { return /databases/$(database)/documents/circles/$(cid); }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function keepsHistory(uid) { return exists(userPath(uid)) && get(userPath(uid)).data.get('keepHistory', false) == true; }
    function memberPath(cid, uid) { return /databases/$(database)/documents/circles/$(cid)/members/$(uid); }
    function placePath(cid, pid) { return /databases/$(database)/documents/circles/$(cid)/places/$(pid); }
    function locationPath(cid, uid) { return /databases/$(database)/documents/circles/$(cid)/locations/$(uid); }
    function codePath(code) { return /databases/$(database)/documents/joinCodes/$(code); }

    function isMember(cid) {
      // Orphaned subcollection documents stop being visible as soon as the parent circle is gone.
      return signedIn() && exists(circlePath(cid)) && exists(memberPath(cid, request.auth.uid));
    }
    function isOwner(cid) { return isMember(cid) && get(circlePath(cid)).data.ownerUid == request.auth.uid; }

    function validCodeFormat(code) {
      return code is string && code.matches('[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{10}');
    }
    // Email verification (FR-007): the ID token must carry email_verified.
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function requestPath(cid, uid) { return /databases/$(database)/documents/circles/$(cid)/joinRequests/$(uid); }
    function nameOk(v, maxLen) { return v is string && v.size() >= 1 && v.size() <= maxLen; }

    // ---------- users (private profile) ----------
    function validProfile(d) {
      return d.keys().hasOnly(['displayName', 'phone', 'birthYear', 'createdAt', 'updatedAt', 'keepHistory', 'retentionDays', 'notifOff', 'notifMuted', 'notifSeenAt'])
        && d.keys().hasAll(['displayName', 'birthYear', 'createdAt', 'updatedAt'])
        && nameOk(d.displayName, 50)
        && d.birthYear is int && d.birthYear >= 1900
        && request.time.year() - d.birthYear >= 13
        && (!('phone' in d) || (d.phone is string && d.phone.matches('[+][1-9][0-9]{6,14}')))
        && (!('keepHistory' in d) || d.keepHistory is bool)
        && (!('retentionDays' in d) || d.retentionDays in [7, 30, 90])
        && (!('notifOff' in d) || (d.notifOff is list && d.notifOff.size() <= 10))
        && (!('notifMuted' in d) || (d.notifMuted is list && d.notifMuted.size() <= 50))
        && (!('notifSeenAt' in d) || d.notifSeenAt is timestamp)
        && d.updatedAt == request.time;
    }

    // One compact document per (member, day): visits + a thinned route. Never raw GPS points.
    function validDay(d, memberUid) {
      return d.keys().hasOnly(['uid', 'day', 'tzOffsetMin', 'visits', 'route', 'lastSeen', 'updatedAt'])
        && d.keys().hasAll(['uid', 'day', 'tzOffsetMin', 'visits', 'route', 'lastSeen', 'updatedAt'])
        && d.uid == memberUid
        && d.day is string && d.day.matches('[0-9]{8}')
        && d.tzOffsetMin is int && d.tzOffsetMin >= -840 && d.tzOffsetMin <= 840
        && d.visits is list && d.visits.size() <= 60
        && d.route is list && d.route.size() <= 400
        && d.lastSeen is int
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.birthYear == resource.data.birthYear
        && request.resource.data.createdAt == resource.data.createdAt;
      // No list. Deleting your own profile is part of best-effort account deletion.
      allow delete: if signedIn() && request.auth.uid == uid;

      // Private master copy of the user's own daily history (Increment 4).
      match /history/{day} {
        allow get, list: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/users/$(uid)).data.get('keepHistory', false) == true
          && validDay(request.resource.data, uid)
          && request.resource.data.day == day;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- circles ----------
    function validCircleCreate(d, circleId) {
      return verified()
        && d.keys().hasOnly(['name', 'ownerUid', 'requiresApproval', 'joinCode', 'createdAt'])
        && d.keys().hasAll(['name', 'ownerUid', 'requiresApproval', 'joinCode', 'createdAt'])
        && nameOk(d.name, 40)
        && d.ownerUid == request.auth.uid
        && d.requiresApproval == false
        && d.createdAt == request.time
        && validCodeFormat(d.joinCode)
        && getAfter(memberPath(circleId, request.auth.uid)).data.role == 'owner'
        && getAfter(codePath(d.joinCode)).data.circleId == circleId;
    }

    function validCircleUpdate(circleId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'joinCode', 'requiresApproval'])
        && nameOk(request.resource.data.name, 40)
        && request.resource.data.requiresApproval is bool
        && (request.resource.data.joinCode == resource.data.joinCode
            || (validCodeFormat(request.resource.data.joinCode)
                && getAfter(codePath(request.resource.data.joinCode)).data.circleId == circleId
                && getAfter(codePath(request.resource.data.joinCode)).data.revoked == false));
    }

    match /circles/{cid} {
      allow get: if isMember(cid);
      allow create: if signedIn() && validCircleCreate(request.resource.data, cid);
      // Ownership transfer: only the owner, only the ownerUid changes, and the same batch must flip both
      // member roles (new owner -> owner, old owner -> member).
      allow update: if isOwner(cid) && (validCircleUpdate(cid) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid'])
          && request.resource.data.ownerUid != request.auth.uid
          && exists(memberPath(cid, request.resource.data.ownerUid))
          && getAfter(memberPath(cid, request.resource.data.ownerUid)).data.role == 'owner'
          && getAfter(memberPath(cid, request.auth.uid)).data.role == 'member'));
      // Deleting a circle is the owner's call; the app deletes everything below it first (no server).
      allow delete: if isOwner(cid)
        // Circle deletion must remove the owner's membership and location in the same final batch.
        && !existsAfter(memberPath(cid, request.auth.uid))
        && !existsAfter(locationPath(cid, request.auth.uid));
      // No list: members find circles via the members collection group.

      function validJoinCode(code, circleId) {
        let c = get(codePath(code)).data;
        return validCodeFormat(code)
          && c.circleId == circleId
          && c.revoked == false
          && (!('expiresAt' in c) || c.expiresAt > request.time);
      }

      function validMemberCreate(d, circleId, memberUid) {
        return verified()
          && d.uid == memberUid
          && nameOk(d.displayName, 50)
          && d.joinedAt == request.time
          && d.get('sharesLocation', false) == false   // sharing is always opt-in, off at creation
          && d.get('paused', false) == false
          && d.get('historyShared', false) == false   // history sharing is a separate opt-in
          && (
            // Owner membership: only together with creating the circle in the same batch.
            (d.role == 'owner'
              && d.keys().hasOnly(['uid', 'role', 'displayName', 'joinedAt', 'sharesLocation', 'paused', 'historyShared'])
              && d.keys().hasAll(['uid', 'role', 'displayName', 'joinedAt'])
              && !exists(circlePath(circleId))
              && getAfter(circlePath(circleId)).data.ownerUid == memberUid)
            ||
            // Regular membership: requires a valid, unrevoked, unexpired join code for THIS circle.
            (d.role == 'member'
              && d.keys().hasOnly(['uid', 'role', 'displayName', 'joinedAt', 'joinCode', 'sharesLocation', 'paused', 'historyShared'])
              && d.keys().hasAll(['uid', 'role', 'displayName', 'joinedAt', 'joinCode'])
              && exists(circlePath(circleId))
              && (
                // Open circle: a valid, unrevoked, unexpired code.
                (get(circlePath(circleId)).data.requiresApproval == false && validJoinCode(d.joinCode, circleId))
                ||
                // Approval circle: the owner must have approved this user's request.
                (get(circlePath(circleId)).data.requiresApproval == true
                  && validCodeFormat(d.joinCode)
                  && exists(requestPath(circleId, memberUid))
                  && get(requestPath(circleId, memberUid)).data.status == 'approved')))
          );
      }

      // A member can read another person's current location only while that exact
      // member explicitly shares with this circle and has not paused sharing.
      function canSeeLocation(memberUid) {
        return exists(memberPath(cid, memberUid))
          && get(memberPath(cid, memberUid)).data.get('sharesLocation', false) == true
          && get(memberPath(cid, memberUid)).data.get('paused', false) == false;
      }

      // ---- Circle-scoped live location projection (Increment 2) ----
      // One document per (circle, sharing member). The owner of the location writes it only while
      // sharing is ON and NOT paused for that exact circle; the app deletes it atomically when sharing
      // is switched off/paused/left, so viewers never keep seeing stale data after revocation.
      function validLocation(d, memberUid) {
        return d.keys().hasOnly(['uid', 'lat', 'lng', 'accuracy', 'sharing', 'updatedAt', 'batteryLevel'])
          && d.keys().hasAll(['uid', 'lat', 'lng', 'accuracy', 'sharing', 'updatedAt'])
          && d.uid == memberUid
          && d.sharing == true
          && d.lat is number && d.lat >= -90 && d.lat <= 90
          && d.lng is number && d.lng >= -180 && d.lng <= 180
          && d.accuracy is number && d.accuracy >= 0 && d.accuracy <= 100000
          && d.updatedAt == request.time
          // Battery is optional, integer-only, and requires separate per-circle consent.
          && (!('batteryLevel' in d)
              || (d.batteryLevel is int && d.batteryLevel >= 0 && d.batteryLevel <= 100
                  && get(memberPath(cid, memberUid)).data.get('shareBattery', false) == true));
      }

      match /locations/{uid} {
        // Direct reads re-check the member's current consent, even if an old document is left behind.
        allow get: if isMember(cid)
          && resource.data.get('sharing', false) == true
          && canSeeLocation(uid);
        // The client queries only sharing=true documents. The member-update rules below enforce
        // atomic deletion when sharing is paused/off, so inactive members cannot retain new documents.
        allow list: if isMember(cid) && resource.data.get('sharing', false) == true;
        allow create, update: if signedIn() && request.auth.uid == uid
          && isMember(cid)
          && get(memberPath(cid, uid)).data.get('sharesLocation', false) == true
          && get(memberPath(cid, uid)).data.get('paused', false) == false
          && validLocation(request.resource.data, uid);
        // The sharer can always stop; the owner can clean up after removing a member.
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(cid));
      }

      // ---- Saved places (Increment 3) ----
      function validPlace(d) {
        return nameOk(d.name, 50)
          && d.lat is number && d.lat >= -90 && d.lat <= 90
          && d.lng is number && d.lng >= -180 && d.lng <= 180
          && d.radiusM is number && d.radiusM >= 100 && d.radiusM <= 1000;
      }

      match /places/{pid} {
        allow get, list: if isMember(cid);
        allow create: if isMember(cid)
          && request.resource.data.keys().hasOnly(['name', 'lat', 'lng', 'radiusM', 'createdBy', 'createdAt'])
          && request.resource.data.keys().hasAll(['name', 'lat', 'lng', 'radiusM', 'createdBy', 'createdAt'])
          && validPlace(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        // Creator or circle owner may edit/delete. Max 20 places per circle is enforced in the app only.
        allow update: if isMember(cid)
          && (resource.data.createdBy == request.auth.uid || isOwner(cid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lat', 'lng', 'radiusM'])
          && validPlace(request.resource.data);
        allow delete: if isMember(cid)
          && (resource.data.createdBy == request.auth.uid || isOwner(cid));
      }

      // Per-user alert preferences for a place. Private to the subscriber.
      // Remote push is deferred: these only drive the in-app notification feed.
      match /placeSubscriptions/{subId} {
        allow get: if signedIn() && resource.data.subscriberUid == request.auth.uid;
        allow create, update: if isMember(cid)
          && request.resource.data.keys().hasOnly(['subscriberUid', 'placeId', 'arrive', 'leave', 'allMembers', 'memberUids', 'paused', 'updatedAt'])
          && request.resource.data.keys().hasAll(['subscriberUid', 'placeId', 'arrive', 'leave', 'allMembers', 'memberUids', 'updatedAt'])
          && request.resource.data.subscriberUid == request.auth.uid
          && subId == request.auth.uid + '_' + request.resource.data.placeId
          && request.resource.data.arrive is bool
          && request.resource.data.leave is bool
          && request.resource.data.allMembers is bool
          && request.resource.data.memberUids is list && request.resource.data.memberUids.size() <= 20
          && (!('paused' in request.resource.data) || request.resource.data.paused is bool)
          && request.resource.data.updatedAt == request.time;
        // Id-based so batch deletes of absent docs work: own preferences, or owner cleanup on circle deletion.
        allow delete: if signedIn() && (subId.matches(request.auth.uid + '_.*') || isOwner(cid));
      }

      // Arrival/departure events detected on the sharing member's own device (ADR-0002).
      // Client-created and therefore UNTRUSTED for anything beyond this circle's in-app feed.
      match /placeEvents/{eventId} {
        allow get, list: if isMember(cid);
        allow create: if isMember(cid)
          && request.resource.data.keys().hasOnly(['placeId', 'placeName', 'memberUid', 'memberName', 'type', 'visitId', 'occurredAt'])
          && request.resource.data.keys().hasAll(['placeId', 'placeName', 'memberUid', 'memberName', 'type', 'visitId', 'occurredAt'])
          && request.resource.data.memberUid == request.auth.uid
          && request.resource.data.type in ['arrive', 'leave']
          && request.resource.data.visitId is string
          && request.resource.data.visitId.size() >= 1 && request.resource.data.visitId.size() <= 20
          && eventId == request.auth.uid + '_' + request.resource.data.placeId + '_' + request.resource.data.visitId + '_' + request.resource.data.type
          && request.resource.data.occurredAt == request.time
          && exists(placePath(cid, request.resource.data.placeId))
          && get(placePath(cid, request.resource.data.placeId)).data.name == request.resource.data.placeName
          && get(memberPath(cid, request.auth.uid)).data.displayName == request.resource.data.memberName
          && get(memberPath(cid, request.auth.uid)).data.get('sharesLocation', false) == true
          && get(memberPath(cid, request.auth.uid)).data.get('paused', false) == false;
        // Events are immutable; members may delete only their own (best-effort retention cleanup).
        allow delete: if signedIn() && (resource.data.memberUid == request.auth.uid || isOwner(cid));
      }

      // ---- Circle-scoped copy of a member's daily history (Increment 4) ----
      // Written by the member only while sharing is on, not paused AND history sharing is on for this
      // exact circle. Readable by circle members only while that member keeps both switches on.
      // Viewers read single documents by id (uid_yyyymmdd); there is no list.
      match /history/{docId} {
        // The master history switch gates circle copies too, so turning it off hides existing copies.
        allow get: if isMember(cid)
          && keepsHistory(resource.data.uid)
          && (resource.data.uid == request.auth.uid
              || (get(memberPath(cid, resource.data.uid)).data.get('historyShared', false) == true
                  && get(memberPath(cid, resource.data.uid)).data.get('sharesLocation', false) == true));
        allow create, update: if signedIn() && isMember(cid)
          && keepsHistory(request.auth.uid)
          && request.resource.data.uid == request.auth.uid
          && docId == request.auth.uid + '_' + request.resource.data.day
          && validDay(request.resource.data, request.auth.uid)
          && get(memberPath(cid, request.auth.uid)).data.get('sharesLocation', false) == true
          && get(memberPath(cid, request.auth.uid)).data.get('paused', false) == false
          && get(memberPath(cid, request.auth.uid)).data.get('historyShared', false) == true;
        // Id-based (works for batch deletes of days that may not exist): own days, or owner cleanup.
        allow delete: if signedIn() && (docId.matches(request.auth.uid + '_[0-9]{8}') || isOwner(cid));
      }

      // ---- Join requests for circles that require approval (FR-014) ----
      match /joinRequests/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isOwner(cid));
        allow list: if isOwner(cid);
        allow create: if verified() && request.auth.uid == uid
          && !exists(memberPath(cid, uid))
          && exists(circlePath(cid))
          && get(circlePath(cid)).data.requiresApproval == true
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'joinCode', 'status', 'createdAt'])
          && request.resource.data.keys().hasAll(['uid', 'displayName', 'joinCode', 'status', 'createdAt'])
          && request.resource.data.uid == uid
          && nameOk(request.resource.data.displayName, 50)
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && validJoinCode(request.resource.data.joinCode, cid);
        // Only the owner can approve (pending -> approved); nothing else may change.
        allow update: if isOwner(cid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'approved';
        // Requester cancels / cleans up after joining; owner rejects. Id-based, batch-safe.
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(cid));
      }

      // ---- Membership / sharing activity shown in the in-app notification feed (FR-080, FR-094) ----
      // Written by the person who acts (or by the owner for removals); names must match member documents.
      // Client-written and untrusted beyond this feed. Immutable; deletable by the actor or the owner.
      function validActivity(d, circleId) {
        return d.keys().hasOnly(['type', 'actorUid', 'actorName', 'subjectUid', 'subjectName', 'checkInStatus', 'checkInPlaceId', 'checkInPlaceName', 'occurredAt'])
          && d.keys().hasAll(['type', 'actorUid', 'actorName', 'occurredAt'])
          && d.actorUid == request.auth.uid
          && d.occurredAt == request.time
          && d.type in ['joined', 'left', 'removed', 'sharing_started', 'sharing_stopped', 'checked_in']
          && (d.type == 'checked_in' || (!('checkInStatus' in d) && !('checkInPlaceId' in d) && !('checkInPlaceName' in d)))
          && (
            (d.type == 'checked_in'
              && isMember(circleId)
              && get(memberPath(circleId, request.auth.uid)).data.displayName == d.actorName
              && d.keys().hasAll(['checkInStatus'])
              && d.checkInStatus is string
              && d.checkInStatus in ['im_okay', 'arrived_safely', 'on_my_way', 'running_late']
              && (
                (!('checkInPlaceId' in d) && !('checkInPlaceName' in d))
                || ('checkInPlaceId' in d && 'checkInPlaceName' in d
                  && d.checkInPlaceId is string && d.checkInPlaceId.size() > 0 && d.checkInPlaceId.size() <= 128
                  && nameOk(d.checkInPlaceName, 50)
                  && exists(placePath(circleId, d.checkInPlaceId))
                  && get(placePath(circleId, d.checkInPlaceId)).data.name == d.checkInPlaceName)
              )
              && !('subjectUid' in d)
              && !('subjectName' in d))
            ||
            (d.type == 'joined'
              && !exists(memberPath(circleId, request.auth.uid))
              && existsAfter(memberPath(circleId, request.auth.uid))
              && getAfter(memberPath(circleId, request.auth.uid)).data.displayName == d.actorName)
            ||
            (d.type == 'left'
              && exists(memberPath(circleId, request.auth.uid))
              && !existsAfter(memberPath(circleId, request.auth.uid))
              && get(memberPath(circleId, request.auth.uid)).data.displayName == d.actorName)
            ||
            (d.type == 'sharing_started'
              && isMember(circleId)
              && get(memberPath(circleId, request.auth.uid)).data.displayName == d.actorName
              && getAfter(memberPath(circleId, request.auth.uid)).data.get('sharesLocation', false) == true)
            ||
            (d.type == 'sharing_stopped'
              && isMember(circleId)
              && get(memberPath(circleId, request.auth.uid)).data.displayName == d.actorName
              && getAfter(memberPath(circleId, request.auth.uid)).data.get('sharesLocation', false) == false)
            ||
            (d.type == 'removed'
              && isOwner(circleId)
              && d.subjectUid is string && d.subjectUid != request.auth.uid
              && exists(memberPath(circleId, d.subjectUid))
              && !existsAfter(memberPath(circleId, d.subjectUid))
              && get(memberPath(circleId, d.subjectUid)).data.displayName == d.subjectName
              && get(memberPath(circleId, request.auth.uid)).data.displayName == d.actorName)
          );
      }

      match /activity/{activityId} {
        allow get, list: if isMember(cid);
        allow create: if signedIn() && validActivity(request.resource.data, cid);
        allow delete: if signedIn() && isOwner(cid);
      }

      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isMember(cid));
        allow list: if isMember(cid);
        allow create: if signedIn() && request.auth.uid == uid
          && validMemberCreate(request.resource.data, cid, uid);
        // A member may only change their own display name and their own sharing switches.
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'sharesLocation', 'paused', 'historyShared', 'pausedUntil', 'shareBattery'])
          && nameOk(request.resource.data.displayName, 50)
          && request.resource.data.get('sharesLocation', false) is bool
          && request.resource.data.get('paused', false) is bool
          && request.resource.data.get('historyShared', false) is bool
          && request.resource.data.get('shareBattery', false) is bool
          && (!('pausedUntil' in request.resource.data) || request.resource.data.pausedUntil is timestamp)
          // Enabling battery sharing is a separate opt-in and requires active location sharing.
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['shareBattery'])
              || (request.resource.data.get('shareBattery', false) == true
                  && request.resource.data.get('sharesLocation', false) == true
                  && request.resource.data.get('paused', false) == false)
              || (request.resource.data.get('shareBattery', false) == false
                  && (!existsAfter(locationPath(cid, uid))
                      || !('batteryLevel' in getAfter(locationPath(cid, uid)).data)))
          // Turning sharing off or pausing must remove the live location in the same atomic batch.
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sharesLocation', 'paused'])
              || (request.resource.data.get('sharesLocation', false) == true
                  && request.resource.data.get('paused', false) == false)
              || !existsAfter(locationPath(cid, uid)));
        // Role flips happen only as part of an ownership transfer batch (circle.ownerUid changes too).
        allow update: if signedIn() && isOwner(cid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && getAfter(circlePath(cid)).data.ownerUid != get(circlePath(cid)).data.ownerUid
          && ((request.resource.data.role == 'owner' && getAfter(circlePath(cid)).data.ownerUid == uid)
              || (request.resource.data.role == 'member' && uid == request.auth.uid));
        // Leave (non-owner), owner removes someone else, or the owner leaves together with deleting the circle.
        allow delete: if signedIn()
          && ((request.auth.uid == uid && resource.data.role != 'owner')
              || (request.auth.uid == uid && !existsAfter(circlePath(cid)))
              || (request.auth.uid != uid && isOwner(cid)))
          // Leaving, removal, and circle deletion must not leave a query-visible location behind.
          && !existsAfter(locationPath(cid, uid));
      }
    }

    // Collection-group query: "which circles am I in?" — a user may list only their own membership docs.
    match /{path=**}/members/{uid} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Collection-group query: "which join requests have I made?" — own requests only.
    match /{path=**}/joinRequests/{rid} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Collection-group query: "which place alerts have I set?" — own subscriptions only.
    match /{path=**}/placeSubscriptions/{subId} {
      allow list: if signedIn() && resource.data.subscriberUid == request.auth.uid;
    }

    // ---------- join codes ----------
    match /joinCodes/{code} {
      allow get: if signedIn() && validCodeFormat(code);
      allow list: if false;
      allow create: if signedIn() && validCodeFormat(code)
        && request.resource.data.keys().hasOnly(['circleId', 'createdBy', 'revoked', 'createdAt', 'expiresAt'])
        && request.resource.data.keys().hasAll(['circleId', 'createdBy', 'revoked', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.revoked == false
        && request.resource.data.createdAt == request.time
        && (!('expiresAt' in request.resource.data)
            || (request.resource.data.expiresAt is timestamp
                && request.resource.data.expiresAt > request.time
                && request.resource.data.expiresAt < request.time + duration.value(31, 'd')))
        && getAfter(circlePath(request.resource.data.circleId)).data.ownerUid == request.auth.uid;
      // Owner may only revoke (never re-point or un-revoke).
      allow update: if signedIn() && isOwner(resource.data.circleId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
        && request.resource.data.revoked == true;
      allow delete: if signedIn() && isOwner(resource.data.circleId);
    }
  }
}
