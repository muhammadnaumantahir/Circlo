# Circlo build-time Firebase configuration (placeholders only - never commit real values you consider private).
# Pass to Flutter as --dart-define, e.g.:
#   flutter run --dart-define-from-file=env.json
# env.json (git-ignored) example:
# {
#   "FIREBASE_API_KEY": "your-web-api-key",
#   "FIREBASE_API_KEY_ANDROID": "your-android-api-key",
#   "FIREBASE_API_KEY_IOS": "your-ios-api-key",
#   "FIREBASE_PROJECT_ID": "your-project-id",
#   "FIREBASE_MESSAGING_SENDER_ID": "000000000000",
#   "FIREBASE_AUTH_DOMAIN": "your-project-id.firebaseapp.com",
#   "FIREBASE_APP_ID_WEB": "1:000000000000:web:xxxxxxxx",
#   "FIREBASE_APP_ID_ANDROID": "1:000000000000:android:xxxxxxxx",
#   "FIREBASE_APP_ID_IOS": "1:000000000000:ios:xxxxxxxx"
# }
# Local emulator: add "USE_FIREBASE_EMULATOR": true (Android emulator host: "FIREBASE_EMULATOR_HOST": "10.0.2.2")
# NEVER put FCM server keys / service-account files here or anywhere in the app.
FIREBASE_API_KEY=
FIREBASE_API_KEY_ANDROID=
FIREBASE_API_KEY_IOS=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID_WEB=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=
USE_FIREBASE_EMULATOR=false
